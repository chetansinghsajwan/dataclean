{
    "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "files": {
        "includes": ["**", "!external", "!.devcontainer/devcontainer-lock.json"]
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "overrides": [
        {
            "includes": ["devbox.json", "biome.jsonc", ".vscode/**"],
            "json": {
                "parser": {
                    "allowComments": true,
                    "allowTrailingCommas": true
                },
                "formatter": {
                    "trailingCommas": "all"
                }
            }
        }
    ]
}
