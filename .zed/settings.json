{
    // Basic settings
    "tab_size": 4,
    "hard_tabs": false,
    "format_on_save": "on",
    "preferred_line_length": 100,

    "languages": {
        "Python": {
            "language_servers": ["ty", "ruff"],
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:py:stdio"]
                }
            }
        },
        "Shell Script": {
            "language_servers": ["shuck"],
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:sh:stdio"]
                }
            }
        },
        "YAML": {
            "language_servers": ["yaml-language-server"],
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:yaml:stdio"]
                }
            }
        },
        "TOML": {
            "language_servers": ["taplo"],
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:toml:stdio"]
                }
            }
        },
        "JSON": {
            "language_servers": ["biome", "!json-language-server"],
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:json:stdio"]
                }
            }
        },
        "JSONC": {
            "language_servers": ["biome", "!json-language-server"],
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:json:stdio"]
                }
            }
        },
        "Markdown": {
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:md:stdio"]
                }
            }
        },
        "Nix": {
            "formatter": {
                "external": {
                    "command": "task",
                    "arguments": ["fmt:nix:stdio"]
                }
            }
        }
    },
    "lsp": {
        "shuck": {
            "binary": {
                "path": "shuck",
                "arguments": ["server"]
            }
        },
        "taplo": {
            "binary": {
                "path": "taplo",
                "arguments": ["lsp", "stdio"]
            }
        }
    }
}
